
# =========================
# Stage 1: Builder
# =========================
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# Create isolated virtual environment
RUN /usr/local/bin/python -m venv /opt/venv

COPY pyproject.toml ./
COPY src/ ./src/

# Install project dependencies
RUN /opt/venv/bin/python -m pip install --upgrade \
        pip setuptools wheel && \
    /opt/venv/bin/python -m pip install . && \
    /opt/venv/bin/python -m pip check

# Remove packaging tools from serving venv
RUN /opt/venv/bin/python -m pip uninstall -y \
        setuptools wheel pip

# =========================
# Stage 2: Runtime
# =========================
FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_SOURCE=local \
    MODEL_DIR=/app/model \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# Copy installed application dependencies
COPY --from=builder /opt/venv /opt/venv

# Copy trained model
COPY model/ /app/model/

# Remove unused packaging tools from system Python
# This targets the vendored packages inside setuptools
RUN /usr/local/bin/python -m pip uninstall -y \
        setuptools wheel && \
    if [ -d /usr/local/lib/python3.11/site-packages/setuptools ]; then \
        echo "ERROR: setuptools directory still exists"; \
        exit 1; \
    fi

# Create non-root user
RUN useradd --create-home appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

CMD ["uvicorn", \
     "fraud_detection.serving.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000"]
