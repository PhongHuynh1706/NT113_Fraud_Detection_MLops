
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_SOURCE=local \
    MODEL_DIR=/app/model

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir .

COPY model/ /app/model/

RUN useradd --create-home appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

CMD ["uvicorn", \
     "fraud_detection.serving.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000"]
